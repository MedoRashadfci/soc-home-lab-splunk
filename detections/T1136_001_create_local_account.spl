# MITRE ATT&CK: T1136.001 - Create Local Account
# Data Source: Sysmon (EventCode 1 - Process Creation)
index=sysmon EventCode=1 (Image="*net.exe" OR Image="*net1.exe") (CommandLine="*user*" OR CommandLine="*localgroup*") CommandLine="*/add*"
| table _time, host, User, ParentImage, Image, CommandLine
